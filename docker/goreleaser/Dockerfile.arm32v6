ARG BUILDPLATFORM
FROM --platform=$BUILDPLATFORM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS Builder
WORKDIR /app
RUN apk add --no-cache upx
COPY flare ./
RUN upx -9 -o flare.minify flare && \
    mv flare.minify flare

FROM arm32v6/alpine:3.24.4@sha256:57e8259362d1f655e190c00988451cfef57b735fb9935b97822b02d4634afa55
ENV TZ=Asia/Shanghai
RUN apk add tzdata && \
    cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    rm -rf /var/cache/apk/*
COPY --from=Builder /app/flare /bin/flare
EXPOSE 5005
WORKDIR /app
CMD ["flare"]

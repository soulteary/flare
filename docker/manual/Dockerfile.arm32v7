ARG FLARE_BASE_IMAGE
FROM $FLARE_BASE_IMAGE AS Builder
RUN go run build/build.go
RUN export VERSION=$(cat RELEASE_VERSION) && \
    export COMMIT=$(cat RELEASE_COMMIT) && \
    export BUILD_DATE=`date +%FT%T%z` && \
    echo "$BUILD_DATE / $COMMIT / $VERSION" && \
    GOARM=7	GOARCH=arm go build -ldflags "-w -s -X 'github.com/soulteary/version-kit/v4.Version=$VERSION' -X 'github.com/soulteary/version-kit/v4.Commit=$COMMIT' -X 'github.com/soulteary/version-kit/v4.BuildDate=$BUILD_DATE'" -o flare main.go
RUN upx -9 -o flare.minify flare && mv flare.minify flare


FROM arm32v7/alpine:3.24.4@sha256:ba2a50f072dcb18ef099ddbf2027d4a215e6e0b1cb5c4641e2fae44cf9fd740f
COPY --from=Builder /app/flare /bin/flare
ENV TZ=Asia/Shanghai
RUN apk add tzdata && \
    cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    rm -rf /var/cache/apk/*
WORKDIR /app
CMD ["flare"]